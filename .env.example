# Copy to .env (gitignored) and fill in. Both values are public by design:
# only the project URL and the PUBLIC anon key belong here. Never put any other key in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Minutes of inactivity before automatic sign-out (0 switches it off for everyone).
# Each user can change their own value in Settings. Default: 15
VITE_IDLE_TIMEOUT_MINUTES=15

# Optional. Base path the site is served from. Default: /payroll-hub/
VITE_BASE_PATH=/payroll-hub/

# Optional. "true" leaves the Content Security Policy tag out of the build. Only for
# troubleshooting: leave it unset normally.
# VITE_DISABLE_CSP=true

# Optional, local development only. Ignored by production builds.
# Lets you explore the UI with fake data and no Supabase project. `npm run dev:demo` sets it for you.
VITE_DEMO_MODE=false
